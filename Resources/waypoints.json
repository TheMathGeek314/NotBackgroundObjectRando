[
  //general macros
  //add to anything that has "alt Breakeble Pole" or "Breakeble Pole",and maybe to some other things.
  //The marco below also lacks sharp shadow directions,and maybe shade soul(no longer stateless)
  {
    "name": "Can_Break_Poles",
    "logic": "(SIDESLASH | CYCLONE | GREATSLASH | LEFTDASHSLASH | RIGHTDASHSLASH)",
    "stateless": true
  },
  {
    "name": "ANYNAILLENGTH",
    "logic": "(LONGNAIL | MARKOFPRIDE | CYCLONE | GREATSLASH | DASHSLASH)",
    "stateless": true
  },
  //kedge to waterways
  {
    "name": "Waterways_14_Right",
    "logic": "(Waterways_14[bot2] + (RIGHTCLAW | WINGS + LEFTCLAW | $SHRIEKPOGO[before:ITEMSOUL])) | (Waterways_14[bot1] + (ANYCLAW | $SHRIEKPOGO[2]) + (ACID | RIGHTSUPERDASH)) | (Stag-East_Waterways?FALSE + Can_Stag)"
  },
  {
    "name": "Waterways_14_Middle",
    "logic": "(Waterways_14[bot1] + (ANYCLAW | $SHRIEKPOGO[2]) + (ACID | RIGHTSUPERDASH)) | (Waterways_14[bot2] + (RIGHTCLAW | WINGS + LEFTCLAW | $SHRIEKPOGO[before:ITEMSOUL]) + (ACID | LEFTSUPERDASH)) | (Stag-East_Waterways?FALSE + Can_Stag)"
  },
  {
    "name": "Waterways_14_Left",
    "logic": "(Waterways_14[bot1] + (ANYCLAW | $SHRIEKPOGO[2])) | (Waterways_14[bot2] + (RIGHTCLAW | WINGS + LEFTCLAW | $SHRIEKPOGO[before:ITEMSOUL]) + (ACID | LEFTSUPERDASH)) | (Stag-East_Waterways?FALSE + Can_Stag)"
  },
  {
    "name": "Waterways_14_Top",
    "logic": "(Waterways_14[bot1] + (ANYCLAW | $SHRIEKPOGO[2]) + (RIGHTSUPERDASH + WINGS + (RIGHTCLAW | LEFTCLAW + ENEMYPOGOS | ENEMYPOGOS + DANGEROUSSKIPS) | ACID + (RIGHTCLAW | LEFTCLAW + WINGS | WINGS + ENEMYPOGOS + DANGEROUSSKIPS))) | (Waterways_14[bot2] + (RIGHTCLAW | WINGS + LEFTCLAW | $SHRIEKPOGO[before:ITEMSOUL]) + (LEFTSUPERDASH + WINGS + (RIGHTCLAW | LEFTCLAW + ENEMYPOGOS | ENEMYPOGOS + DANGEROUSSKIPS) | ACID + (RIGHTCLAW | LEFTCLAW + WINGS | WINGS + ENEMYPOGOS + DANGEROUSSKIPS))) | (Stag-East_Waterways?FALSE + Can_Stag + (RIGHTSUPERDASH + WINGS + (RIGHTCLAW | LEFTCLAW + ENEMYPOGOS | ENEMYPOGOS + DANGEROUSSKIPS) | ACID + (RIGHTCLAW | LEFTCLAW + WINGS | WINGS + ENEMYPOGOS + DANGEROUSSKIPS))) | (Waterways_14[bot1] + (ANYCLAW | $SHRIEKPOGO[2]) + (RIGHTSUPERDASH | ACID) + (RIGHTCLAW | LEFTCLAW + WINGS) + Collapser-Waterways_Tram_Grub?FALSE) | (Waterways_14[bot2] + (RIGHTCLAW | WINGS + LEFTCLAW) + Collapser-Waterways_Tram_Grub?FALSE)"
  },
  //city bridge
  {
    "name": "City_Bridge_Above_Fountain_Right_Side",
    "logic": "(Ruins1_18[right1] | (Ruins1_18[left1] + Lever-City_Bridge_Above_Fountain?FALSE))"
  },
  {
    "name": "City_Bridge_Above_Fountain_Bottom",
    "logic": "(Ruins1_18[right2])"
  },
  //stone sanctuary
  {
    "name": "Stone_Sanctuary_Internal",
    "logic": "((Fungus1_35[left1] | Fungus1_35[right1]) + (DARKROOMS | LANTERN))"
  },
  //love tower
  {
    "name": "Below_Love_Tower",
    "logic": "((Ruins2_07[left1] | Stag-Flooded_Station?FALSE + Can_Stag) + (SWIM | RIGHTSKIPACID | (COMPLEXSKIPS + ACIDSKIPS + RIGHTDASH + WINGS + (SPELLAIRSTALL + $CASTSPELL | RIGHTSHARPSHADOW))) | Ruins2_07[top1] | Ruins2_07[right1]+(LEFTCLAW|WINGS|LEFTDASH))"
  }
]
